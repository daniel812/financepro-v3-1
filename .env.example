# Supabase Config (Already provided by platform)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram Bot Config
TELEGRAM_BOT_TOKEN=
APP_URL=

# Secret Vercel sends in the Authorization header of cron-triggered requests
# (set to a random string; Vercel automatically attaches it as "Bearer <value>")
CRON_SECRET=

# Gemini API Key (Already provided by platform as GEMINI_API_KEY)
GEMINI_API_KEY=
